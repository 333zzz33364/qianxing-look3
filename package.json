{
  "name": "look3-dsh-plugin",
  "version": "3.1.0",
  "description": "千星look3：保留 Look2 界面的 UI 动画编辑与 Lua 模拟器",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "main": "dsh-plugin/dist/index.js",
  "exports": {
    ".": "./dsh-plugin/dist/index.js",
    "./skill": "./dsh-plugin/dist/skill.js",
    "./preset": "./dsh-plugin/dist/preset.js",
    "./client": "./dsh-plugin/dist/client.js",
    "./cordis.patch.yml": "./dsh-plugin/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh-plugin/dist",
    "dsh-plugin/lib/play.html",
    "dsh-plugin/skill.md",
    "dsh-plugin/presets",
    "dsh-plugin/cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./dsh-plugin/cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "prepare": "node scripts/build.mjs dsh-plugin",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "pack:release": "node scripts/pack.mjs",
    "test:packages": "node scripts/smoke-packages.mjs",
    "test:git-install": "node scripts/smoke-git-install.mjs",
    "dev:web": "node scripts/build.mjs web && node web/server.js",
    "start:web": "node web/dist/server.js",
    "upstream:check": "node scripts/upstream-sync.mjs check",
    "upstream:status": "node scripts/upstream-sync.mjs status",
    "test:upstream": "node --test scripts/test/upstream-sync.test.mjs",
    "test:harness": "node scripts/smoke-harness.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.100",
    "fengari": "0.1.5",
    "protobufjs": "8.7.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.2.0-rc.1 || ^0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.2",
    "esbuild": "0.25.12"
  },
  "license": "GPL-3.0-only"
}
